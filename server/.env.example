# Paste your real Groq key after the equals sign. Keep this file on the backend only.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_MS=90000
PORT=5001
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/hireflow
JWT_SECRET=replace_with_a_long_random_secret_before_running
JWT_EXPIRES_IN=7d
NODE_ENV=development
# Required to send organization invitation emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Use an address on a domain verified with your SMTP provider.
# Mailtrap's demomailtrap.co sender is restricted to the account owner's address.
SMTP_FROM=
